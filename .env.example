# PodLens configuration. Copy to `.env` in the project root and fill in values (`.env` is gitignored).
# The API loads it at startup (server/app/core/config.py). Only VITE_* variables reach the browser.

# =====================================================================================
# Core: transcription (Whisper, runs locally)
# =====================================================================================
# WHISPER_MODEL=base                     # tiny | base | small | medium | large (bigger = slower, cleaner text)
# WHISPER_DOWNLOAD_ROOT=                 # default: server/whisper_models
# TORCH_HOME=
# FFMPEG_PATH=                           # only if ffmpeg is not on PATH

# Storage (defaults under server/)
# TRANSCRIPTS_DIR=
# ENTITY_JSON_DIR=

# =====================================================================================
# Entity tagging (NER)
# =====================================================================================
# ENTITY_BACKEND=spacy                   # spacy | claude. Unset + ANTHROPIC_API_KEY set selects Claude.
# SPACY_MODEL=en_core_web_sm             # md/lg are more accurate: pip install en_core_web_md
ANTHROPIC_API_KEY=
# CLAUDE_MODEL=claude-haiku-4-5-20251001 # see https://docs.anthropic.com/en/docs/about-claude/models
# CLAUDE_ENTITY_BATCH=12
#
# Better tagging: a stronger WHISPER_MODEL gives cleaner text; spaCy md/lg beats sm;
# Claude is best on messy podcast speech (paid API).

# =====================================================================================
# Source cards (enrichment)
# =====================================================================================
# Unsplash photos: https://unsplash.com/developers, create an app and copy the "Access Key".
UNSPLASH_ACCESS_KEY=
# The Unsplash "Secret key" is only for OAuth login flows and is not used.
UNSPLASH_SECRET_KEY=
# Wikimedia / Nominatim ask for an identifying User-Agent (use a real contact if public).
# NOMINATIM_USER_AGENT=MyPodcastApp/1.0 (you@example.com)

# =====================================================================================
# AI features: Episode timeline and Ask the episode (LangChain + OpenAI)
# =====================================================================================
OPENAI_API_KEY=
# OPENAI_TIMELINE_MODEL=gpt-5.4-mini
# TIMELINE_WINDOW_CHARS=24000            # transcript is split into windows of this size
# TIMELINE_MAX_CONCURRENCY=4
# TIMELINE_MAX_TRANSCRIPT_CHARS=600000   # requests above this return 413
# OPENAI_ASK_MODEL=gpt-5.4-mini
# OPENAI_EMBED_MODEL=text-embedding-3-small
# ASK_FULL_CONTEXT_CHARS=60000           # shorter transcripts are sent whole; longer use retrieval
# ASK_CHUNK_SEC=60
# ASK_CHUNK_OVERLAP_SEC=15
# ASK_TOP_K=8
# AI entity review: before source cards are built, an LLM fixes misheard names, merges duplicates,
# drops vague tags, and removes Wikipedia summaries/photos that do not match the episode.
# ENTITY_REVIEW=true                     # on by default when OPENAI_API_KEY is set
# OPENAI_REVIEW_MODEL=gpt-5.4-mini

# =====================================================================================
# Deployment
# =====================================================================================
# Extra browser origins allowed by CORS (comma-separated), e.g. a GitHub Pages site:
# CORS_EXTRA_ORIGINS=https://your-github-username.github.io
# Serve a built frontend (dist/) from the API, as the Docker image does:
# STATIC_DIST_DIR=

# Frontend (build time). Full API URL when not using the Vite dev proxy:
# VITE_TRANSCRIBE_URL=http://127.0.0.1:8000/api/transcribe
# Force the NER backend from the UI: spacy | claude
# VITE_ENTITY_BACKEND=
# Public demo build: play pre-processed episodes from public/demo/ (no API calls). See README "Live Demo".
# VITE_DEMO_MODE=true

# =====================================================================================
# Live microphone mode (PARKED, future scope; see server/app/live/README.md)
# =====================================================================================
# ENABLE_LIVE_MODE=false                 # true mounts /api/live and /api/transcribe-chunk
# Realtime engine (uses OPENAI_API_KEY):
# OPENAI_TRANSCRIBE_MODEL=gpt-live-transcribe
# OPENAI_TRANSCRIBE_DELAY=low            # minimal | low | medium | high | xhigh
# OPENAI_TRANSCRIBE_LANGUAGES=en         # comma-separated ISO 639-1; empty = auto
# OPENAI_TRANSCRIBE_PROMPT=A podcast conversation that mentions people, companies, places and technologies.
# OPENAI_REALTIME_URL=wss://api.openai.com/v1/realtime?intent=transcription
# Speech gate that decides when a turn ends:
# LIVE_VAD_RMS=350
# LIVE_VAD_END_SILENCE_SEC=0.7
# LIVE_VAD_MAX_TURN_SEC=12
# Chunked fallback engine:
# LIVE_CHUNK_WINDOW_SEC=10
